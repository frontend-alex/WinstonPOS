{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["VITE_MAPBOX_ACCESS_TOKEN"],
			"inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/.env*"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"env": [
				"NODE_ENV",
				"API_PORT",
				"WEB_ORIGIN",
				"MONGODB_URI",
				"REDIS_URL",
				"VITE_MAPBOX_ACCESS_TOKEN"
			],
			"cache": false,
			"persistent": true
		}
	}
}
