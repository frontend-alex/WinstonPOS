{
	"name": "with-vite",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"dev:web": "pnpm --filter web dev",
		"dev:api": "turbo run dev --filter=api",
		"build:api": "turbo run build --filter=api",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\""
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"eslint": "10.9.1",
		"prettier": "3.9.6",
		"turbo": "^2.11.13"
	},
	"engines": {
		"node": ">=24.20.0"
	},
	"packageManager": "pnpm@11.24.0"
}
