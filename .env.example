# Server configuration. Never expose MONGODB_URI through Vite or browser code.
NODE_ENV=development
API_PORT=3000
# Include the database name in the URL; replace this with your own MongoDB URL.
MONGODB_URI=mongodb://127.0.0.1:27017/opening_radar

# Browser-visible Mapbox public token (pk.*); never use a secret sk.* token.
# Restrict the token to your application's allowed URLs in Mapbox.
VITE_MAPBOX_ACCESS_TOKEN=
